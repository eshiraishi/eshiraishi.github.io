---
interface Props {
    showLabel?: boolean;
}

const { showLabel = false } = Astro.props;

const languages = [
    { code: "en", name: "English", flag: "🇺🇸" },
    { code: "pt", name: "Português", flag: "🇧🇷" },
];
const currentLang = Astro.url.pathname.startsWith("/") ? "en" : "en";
---

<div
    class={`relative ${showLabel ? "inline-flex items-center rounded-md px-2 py-1 font-medium text-neutral-500 transition-colors hover:bg-neutral-50 hover:text-black dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-white" : ""}`}
>
    <select
        id="language-select"
        class={`relative ${showLabel ? "w-full text-left" : "w-auto text-center"} cursor-pointer appearance-none rounded-md bg-transparent ${showLabel ? "p-0 text-base font-medium" : "px-2 py-0.5 text-lg"} ${showLabel ? "text-inherit" : "text-neutral-500"} transition-colors ${showLabel ? "" : "hover:bg-neutral-50 hover:text-black"} focus:outline-none dark:border-neutral-600 ${showLabel ? "" : "dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-white"}`}
        aria-label="Select language"
    >
        {
            languages.map((lang) => (
                <option
                    value={lang.code}
                    selected={lang.code === currentLang}
                    class="bg-white text-black dark:bg-neutral-800 dark:text-white"
                >
                    {showLabel ? lang.name : lang.flag}
                </option>
            ))
        }
    </select>
</div>

<script>
    const setLanguageListener = () => {
        const select = document.getElementById(
            "language-select",
        ) as HTMLSelectElement;

        select?.addEventListener("change", (event) => {
            const target = event.target as HTMLSelectElement;
            const selectedLang = target.value;

            document.dispatchEvent(
                new CustomEvent("languageChange", {
                    detail: { language: selectedLang },
                }),
            );
        });
    };

    setLanguageListener();
    document.addEventListener("astro:after-swap", setLanguageListener);
</script>
