---
import { Icon } from "astro-icon/components";

interface Props {
  showLabel?: boolean;
}

const { showLabel = false } = Astro.props;
---

<button
  class={`theme-toggle-btn inline-flex items-center rounded-md ${showLabel ? "px-2 py-1 font-medium text-neutral-500 transition-colors hover:bg-neutral-50 hover:text-black dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-white" : "p-2 transition-colors hover:bg-neutral-50 dark:border-neutral-600 dark:hover:bg-neutral-800"}`}
  aria-label="Toggle theme"
>
  <span class="sr-only">Toggle theme</span>
  <Icon
    name="heroicons:sun-20-solid"
    class={`theme-toggle-icon size-4 ${showLabel ? "mr-2" : ""} hidden dark:block`}
  />
  <Icon
    name="heroicons:moon-20-solid"
    class={`theme-toggle-icon size-4 ${showLabel ? "mr-2" : ""} dark:hidden`}
  />
  {
    showLabel && (
      <>
        <span class="hidden dark:inline">Light mode</span>
        <span class="dark:hidden">Dark mode</span>
      </>
    )
  }
</button>

<style>
  .theme-toggle-icon {
    color: var(--theme-icon-color);
    transition: color 0.2s;
  }
  .theme-toggle-btn:hover .theme-toggle-icon {
    color: var(--theme-icon-hover-color);
  }
</style>

<script>
  const setListener = () => {
    const buttons = document.querySelectorAll(".theme-toggle-btn");

    buttons.forEach((button) => {
      // Remove any existing listeners to prevent duplicates
      button.removeEventListener("click", toggleTheme);
      button.addEventListener("click", toggleTheme);
    });
  };

  const toggleTheme = () => {
    document.documentElement.classList.toggle("dark");
  };

  setListener();

  document.addEventListener("astro:after-swap", setListener);
</script>
