---
interface Props {
  showLabel?: boolean;
}

const { showLabel = false } = Astro.props;
---

<button
  class={`theme-toggle-btn inline-flex items-center rounded-md ${showLabel ? 'px-2 py-1 font-medium text-neutral-500 transition-colors hover:bg-neutral-50 hover:text-black dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-white' : 'p-2 transition-colors hover:bg-neutral-50 dark:border-neutral-600 dark:hover:bg-neutral-800'}`}
  aria-label="Toggle theme"
>
  <span class="sr-only">Toggle theme</span>
  <div
    class={`theme-icon theme-icon-light hidden ${showLabel ? 'size-4 mr-2' : 'size-4'} dark:block`}
    role="img"
    aria-label="Light mode"
  >
  </div>
  <div
    class={`theme-icon theme-icon-dark ${showLabel ? 'size-4 mr-2' : 'size-4'} dark:hidden`}
    role="img"
    aria-label="Dark mode"
  >
  </div>
  {showLabel && (
    <span class="hidden dark:inline">Light mode</span>
    <span class="dark:hidden">Dark mode</span>
  )}
</button>

<style>
  .theme-icon {
    background-color: var(--theme-icon-color);
    mask: url(attr(src)) no-repeat center;
    mask-size: contain;
    transition: background-color 0.2s ease;
  }

  .theme-icon-light {
    mask: url("/light-mode.svg") no-repeat center;
    mask-size: contain;
  }

  .theme-icon-dark {
    mask: url("/dark-mode.svg") no-repeat center;
    mask-size: contain;
  }

  button:hover .theme-icon {
    background-color: var(--theme-icon-hover-color);
  }
</style>

<script>
  const setListener = () => {
    const buttons = document.querySelectorAll(".theme-toggle-btn");

    buttons.forEach(button => {
      // Remove any existing listeners to prevent duplicates
      button.removeEventListener("click", toggleTheme);
      button.addEventListener("click", toggleTheme);
    });
  };

  const toggleTheme = () => {
    document.documentElement.classList.toggle("dark");
  };

  setListener();

  document.addEventListener("astro:after-swap", setListener);
</script>
