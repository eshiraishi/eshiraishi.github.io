---
import { getRelativeLocaleUrl } from "astro:i18n";
import { DEFAULT_LOCALE, UI, type Locale } from "../lib/i18n";

import { Icon } from "astro-icon/components";
import EpsilonMark from "./EpsilonMark.astro";
import LanguageSelector from "./LanguageSelector.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface TocHeading {
  depth: number;
  slug: string;
  text: string;
  isReference?: boolean;
}

interface Props {
  tocHeadings?: TocHeading[];
  tocLabel?: string;
}

const { tocHeadings = [], tocLabel = "" } = Astro.props;
const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const labels = UI[locale];
const postsUrl = getRelativeLocaleUrl(locale, "posts");
const isPostPage = /^\/(?:en\/)?posts\/[^/]+/.test(Astro.url.pathname);
const hasToc = tocHeadings.length > 0;
---

<header
  class="site-header mb-6"
  data-site-header
  transition:name="header"
>
  <div class="mobile-header">
    {isPostPage && (
      <a
        href={postsUrl}
        class="menu-btn inline-flex items-center no-underline"
        aria-label={labels.backToPosts}
      >
        <Icon
          name="lucide:arrow-left"
          class="icon back-icon"
          aria-hidden="true"
        />
      </a>
    )}
    {!isPostPage && <EpsilonMark />}
    <button id="menu-button" class="menu-btn ml-auto" aria-label="Toggle menu">
      <Icon name="lucide:menu" class="icon back-icon" aria-hidden="true" />
    </button>
  </div>

  <nav class="desktop-nav">
    <div class="desktop-nav-row">
      {isPostPage && (
        <a
          href={postsUrl}
          class="menu-btn inline-flex items-center no-underline"
          aria-label={labels.backToPosts}
        >
          <Icon
            name="lucide:arrow-left"
            class="icon back-icon"
            aria-hidden="true"
          />
        </a>
      )}
      {!isPostPage && <EpsilonMark />}
      <div class="nav-spacer"></div>
      <div class="nav-controls">
        <LanguageSelector />
        <ThemeToggle />
        {hasToc && (
          <button
            type="button"
            class="menu-btn toc-toggle inline-flex items-center"
            aria-label={tocLabel}
            aria-controls="desktop-toc-nav"
            aria-expanded="true"
            data-toc-toggle
          >
            <Icon
              name="lucide:table-of-contents"
              class="icon h-4 w-4"
              aria-hidden="true"
            />
            <span class="sr-only">{tocLabel}</span>
          </button>
        )}
      </div>
    </div>
  </nav>

  <div id="mobile-menu" class="mobile-menu">
    <div class="mobile-menu-header">
      {isPostPage && (
        <a
          href={postsUrl}
          class="menu-btn inline-flex items-center no-underline"
          aria-label={labels.backToPosts}
        >
          <Icon
            name="lucide:arrow-left"
            class="icon back-icon"
            aria-hidden="true"
          />
        </a>
      )}
      {!isPostPage && <EpsilonMark />}
      <button id="menu-close" class="menu-btn ml-auto" aria-label="Close menu">
        <Icon name="lucide:x" class="icon back-icon" aria-hidden="true" />
      </button>
    </div>

    <div class="mobile-menu-item mobile-control-lang">
      <LanguageSelector showLabel={true} />
    </div>
    <div class="mobile-menu-item mobile-control-theme">
      <ThemeToggle showLabel={true} />
    </div>

    {hasToc && (
      <details class="mobile-menu-item mobile-toc" open data-toc-mobile-details>
        <summary
          class="mobile-toc-summary"
          aria-controls="mobile-toc-nav"
          aria-expanded="true"
        >
          <Icon
            name="lucide:table-of-contents"
            class="icon h-4 w-4"
            aria-hidden="true"
          />
          <span>{tocLabel}</span>
          <Icon
            name="lucide:chevron-down"
            class="mobile-toc-chevron icon ml-auto h-4 w-4"
            aria-hidden="true"
          />
        </summary>
        <nav id="mobile-toc-nav" class="mobile-toc-panel" aria-label={tocLabel}>
          <ol class="m-0 space-y-2 p-0 text-xs leading-snug">
            {tocHeadings.map((heading) => (
              <li class:list={[heading.depth === 3 && "pl-3"]}>
                <a
                  href={`#${heading.slug}`}
                  class="toc-link mobile-toc-link theme-muted transition-colors hover:text-neutral-900 dark:hover:text-neutral-100"
                  data-toc-link
                  data-mobile-toc-link
                >
                  {heading.isReference && (
                    <Icon
                      name="lucide:code-2"
                      class="mr-1 inline-block h-3 w-3 align-[-2px]"
                      aria-hidden="true"
                    />
                  )}
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    )}

  </div>
</header>

<script is:inline>
  const setupMenuToggle = () => {
    const menuButton = document.getElementById("menu-button");
    const closeButton = document.getElementById("menu-close");
    const mobileMenu = document.getElementById("mobile-menu");
    const siteHeader = document.querySelector("[data-site-header]");
    if (!mobileMenu) return;

    const openHandler = (e) => {
      e.preventDefault();
      e.stopPropagation();
      mobileMenu.classList.add("is-open");
      siteHeader?.removeAttribute("data-scroll-direction");
      siteHeader?.setAttribute("data-menu-open", "true");
    };
    const closeHandler = (e) => {
      e.preventDefault();
      e.stopPropagation();
      mobileMenu.classList.remove("is-open");
      siteHeader?.removeAttribute("data-scroll-direction");
      siteHeader?.removeAttribute("data-menu-open");
    };
    const navLinkHandler = () => {
      mobileMenu.classList.remove("is-open");
      siteHeader?.removeAttribute("data-scroll-direction");
      siteHeader?.removeAttribute("data-menu-open");
    };

    const buttonHandlers = [
      { button: menuButton, handler: openHandler },
      { button: closeButton, handler: closeHandler },
    ];
    buttonHandlers.forEach(({ button, handler }) => {
      if (button) {
        button.removeEventListener("click", handler);
        button.addEventListener("click", handler);
      }
    });

    document
      .querySelectorAll(".mobile-nav-link, [data-mobile-toc-link]")
      .forEach((link) => {
        link.removeEventListener("click", closeHandler);
        link.removeEventListener("click", navLinkHandler);
        link.addEventListener("click", navLinkHandler);
      });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupMenuToggle);
  } else {
    setupMenuToggle();
  }
  document.addEventListener("astro:after-swap", setupMenuToggle);

  const setupHeaderScroll = () => {
    const siteHeader = document.querySelector("[data-site-header]");
    if (!siteHeader || siteHeader.dataset.scrollInitialized) return;

    let lastScrollY = window.scrollY;
    let revealUntil = 0;
    const handleScroll = () => {
      const currentScrollY = window.scrollY;
      const delta = currentScrollY - lastScrollY;
      const now = performance.now();

      if (currentScrollY <= 8 || delta < 0) {
        siteHeader.removeAttribute("data-scroll-direction");
        revealUntil = now + 500;
      } else if (delta > 2 && now > revealUntil) {
        siteHeader.setAttribute("data-scroll-direction", "down");
      }
      lastScrollY = currentScrollY;
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
    siteHeader.dataset.scrollInitialized = "true";
  };

  setupHeaderScroll();
  document.addEventListener("astro:after-swap", setupHeaderScroll);
</script>
