---
import { getRelativeLocaleUrl } from "astro:i18n";
import { DEFAULT_LOCALE, UI, type Locale } from "../lib/i18n";

import EpsilonMark from "./EpsilonMark.astro";
import { Icon } from "astro-icon/components";
import LanguageSelector from "./LanguageSelector.astro";
import ThemeToggle from "./ThemeToggle.astro";

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const labels = UI[locale];
const postsUrl = getRelativeLocaleUrl(locale, "posts");
const isPostPage = /^\/(?:en\/)?posts\/[^/]+/.test(Astro.url.pathname);
---

<header class="relative mb-6" transition:name="header">
  <div class="mobile-header">
    {isPostPage && (
      <a
        href={postsUrl}
        class="menu-btn inline-flex items-center no-underline"
        aria-label={labels.backToPosts}
      >
        <Icon
          name="heroicons:arrow-left-20-solid"
          class="icon back-icon"
          aria-hidden="true"
        />
      </a>
    )}
    <EpsilonMark />
    <button id="menu-button" class="menu-btn ml-auto" aria-label="Toggle menu">
      <Icon name="heroicons:bars-3-20-solid" class="icon" aria-hidden="true" />
    </button>
  </div>

  <nav class="desktop-nav">
    {isPostPage && (
      <a
        href={postsUrl}
        class="menu-btn inline-flex items-center no-underline"
        aria-label={labels.backToPosts}
      >
        <Icon
          name="heroicons:arrow-left-20-solid"
          class="icon back-icon"
          aria-hidden="true"
        />
      </a>
    )}
    <EpsilonMark />
    <div class="nav-spacer"></div>
    <div class="nav-controls">
      <LanguageSelector />
      <ThemeToggle />
    </div>
  </nav>

  <div id="mobile-menu" class="mobile-menu">
    <div class="mobile-menu-header">
      {isPostPage && (
        <a
          href={postsUrl}
          class="menu-btn inline-flex items-center no-underline"
          aria-label={labels.backToPosts}
        >
          <Icon
            name="heroicons:arrow-left-20-solid"
            class="icon back-icon"
            aria-hidden="true"
          />
        </a>
      )}
      <EpsilonMark />
      <button id="menu-close" class="menu-btn ml-auto" aria-label="Close menu">
        <Icon
          name="heroicons:x-mark-20-solid"
          class="icon"
          aria-hidden="true"
        />
      </button>
    </div>

    <div class="mobile-control-lang">
      <LanguageSelector showLabel={true} />
    </div>
    <div class="mobile-control-theme">
      <ThemeToggle showLabel={true} />
    </div>
  </div>
</header>

<script is:inline>
  const setupMenuToggle = () => {
    const menuButton = document.getElementById("menu-button");
    const closeButton = document.getElementById("menu-close");
    const mobileMenu = document.getElementById("mobile-menu");
    if (!mobileMenu) return;

    const openHandler = (e) => {
      e.preventDefault();
      e.stopPropagation();
      mobileMenu.classList.add("is-open");
    };
    const closeHandler = (e) => {
      e.preventDefault();
      e.stopPropagation();
      mobileMenu.classList.remove("is-open");
    };
    const navLinkHandler = () => {
      mobileMenu.classList.remove("is-open");
    };

    const buttonHandlers = [
      { button: menuButton, handler: openHandler },
      { button: closeButton, handler: closeHandler },
    ];
    buttonHandlers.forEach(({ button, handler }) => {
      if (button) {
        button.removeEventListener("click", handler);
        button.addEventListener("click", handler);
      }
    });

    document.querySelectorAll(".mobile-nav-link").forEach((link) => {
      link.removeEventListener("click", closeHandler);
      link.removeEventListener("click", navLinkHandler);
      link.addEventListener("click", navLinkHandler);
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupMenuToggle);
  } else {
    setupMenuToggle();
  }
  document.addEventListener("astro:after-swap", setupMenuToggle);
</script>
