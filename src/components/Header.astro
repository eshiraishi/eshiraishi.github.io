---
import { EMAIL, SITE_TITLE } from "../consts";

import { Icon } from "astro-icon/components";
import ThemeToggle from "./ThemeToggle.astro";

// Navigation links
const navLinks = [
  { href: "/posts", label: "Posts" },
  { href: `mailto:${EMAIL}`, label: "Contact" },
];
---

<header class="relative mb-6" transition:name="header">
  <!-- Mobile header with title and hamburger button -->
  <div class="mobile-header">
    <a href="/" class="site-title">{SITE_TITLE}</a>
    <button id="menu-button" class="menu-btn" aria-label="Toggle menu">
      <Icon name="heroicons:bars-3-20-solid" class="icon" aria-hidden="true" />
    </button>
  </div>

  <!-- Desktop nav, hidden on small screens -->
  <nav class="desktop-nav">
    <a href="/" class="site-title">{SITE_TITLE}</a>
    {
      navLinks.map((link) => (
        <a href={link.href} class="nav-link">
          {link.label}
        </a>
      ))
    }
    <div class="nav-spacer"></div>
    <div class="nav-controls">
      <!-- <LanguageSelector /> -->
      <ThemeToggle />
    </div>
  </nav>

  <!-- Mobile menu overlay -->
  <div id="mobile-menu" class="mobile-menu -translate-x-full">
    <div class="mobile-menu-header">
      <a href="/" class="site-title">{SITE_TITLE}</a>
      <button id="menu-close" class="menu-btn" aria-label="Close menu">
        <Icon
          name="heroicons:x-mark-20-solid"
          class="icon"
          aria-hidden="true"
        />
      </button>
    </div>

    {
      navLinks.map((link) => (
        <a href={link.href} class="mobile-nav-link">
          {link.label}
        </a>
      ))
    }

    <!-- <div class="mobile-control-lang"><LanguageSelector showLabel={true} /></div> -->
    <div class="mobile-control-theme"><ThemeToggle showLabel={true} /></div>
  </div>
</header>

<style>
  /* Base components */
  .site-title {
    @apply inline-flex items-center whitespace-nowrap rounded-md px-2 py-1 text-lg font-bold text-neutral-500 no-underline transition-colors hover:bg-neutral-50 hover:text-black hover:no-underline dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-white;
  }

  .nav-link,
  .mobile-nav-link {
    @apply inline-flex items-center whitespace-nowrap rounded-md px-2 py-1 font-medium text-neutral-500 no-underline transition-colors hover:bg-neutral-50 hover:text-black hover:no-underline dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-white;
  }

  .mobile-nav-link {
    @apply mb-2;
  }

  .menu-btn {
    @apply rounded-md p-2 transition-colors hover:bg-neutral-50 dark:hover:bg-neutral-800;
    cursor: pointer;
  }

  .icon {
    @apply h-6 w-6;
    color: var(--theme-icon-color);
    transition: color 0.2s ease;
    pointer-events: none;
  }

  .menu-btn:hover .icon {
    color: var(--theme-icon-hover-color);
  }

  /* Layout components */
  .mobile-header {
    @apply flex items-center justify-between md:hidden;
  }

  .desktop-nav {
    @apply hidden items-center gap-2 overflow-x-auto md:flex;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .desktop-nav::-webkit-scrollbar {
    display: none;
  }

  .nav-spacer {
    @apply min-w-4 flex-1;
  }

  .nav-controls {
    @apply flex shrink-0 items-center gap-2;
  }

  .mobile-menu {
    @apply fixed inset-0 z-50 flex transform flex-col bg-white p-4 transition-transform duration-300 dark:bg-neutral-900;
    transform: translateX(-100%);
  }

  .mobile-menu:not(.-translate-x-full) {
    transform: translateX(0);
  }

  .mobile-menu-header {
    @apply mb-4 flex items-center justify-between;
  }

  .mobile-control-lang,
  .mobile-control-theme {
    @apply mb-2 w-full;
  }

  /* Language selector - make it full width */
  .mobile-control-lang :global(div),
  .mobile-control-lang :global(select) {
    @apply w-full;
  }

  /* Theme toggle - keep it simple and functional */
  .mobile-control-theme :global(button) {
    @apply w-full;
  }

  /* Icon masks removed: now using astro-icon for menu icons */
</style>

<!-- Inline script to toggle mobile menu, refactored for simplicity -->
<script is:inline>
  const setupMenuToggle = () => {
    const menuButton = document.getElementById("menu-button");
    const closeButton = document.getElementById("menu-close");
    const mobileMenu = document.getElementById("mobile-menu");
    if (!mobileMenu) return;

    const openHandler = (e) => {
      e.preventDefault();
      e.stopPropagation();
      mobileMenu.classList.remove("-translate-x-full");
    };
    const closeHandler = (e) => {
      e.preventDefault();
      e.stopPropagation();
      mobileMenu.classList.add("-translate-x-full");
    };
    // Handler for mobile nav links: close menu but allow default navigation
    const navLinkHandler = (e) => {
      // don't prevent default so link navigation proceeds
      mobileMenu.classList.add("-translate-x-full");
    };

    // Attach and remove listeners for menu and close buttons
    const buttonHandlers = [
      { button: menuButton, handler: openHandler },
      { button: closeButton, handler: closeHandler },
    ];
    buttonHandlers.forEach(({ button, handler }) => {
      if (button) {
        button.removeEventListener("click", handler);
        button.addEventListener("click", handler);
      }
    });

    // Attach and remove listeners for mobile navigation links
    document.querySelectorAll(".mobile-nav-link").forEach((link) => {
      // remove old handlers
      link.removeEventListener("click", closeHandler);
      link.removeEventListener("click", navLinkHandler);
      // add new handler that closes menu but allows navigation
      link.addEventListener("click", navLinkHandler);
    });
  };

  // Initialize on load and after Astro swaps content
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupMenuToggle);
  } else {
    setupMenuToggle();
  }
  document.addEventListener("astro:after-swap", setupMenuToggle);
</script>
