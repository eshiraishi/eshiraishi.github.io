---
import { type CollectionEntry, getCollection } from "astro:content";
import "katex/dist/katex.css";
import PostNavButton from "../../components/PostNavButton.astro";
import Layout from "../../layouts/Layout.astro";
import { formatDate } from "../../lib/utils";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}
type Props = CollectionEntry<"posts">;

const post = Astro.props;
const { Content } = await post.render();

// Get all posts sorted by date (newest first)
const allPosts = await getCollection("posts");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// Find current post index and get previous/next posts
const currentIndex = sortedPosts.findIndex((p) => p.slug === post.slug);
const previousPost =
  currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  lengthClassName="max-w-3xl"
>
  <main>
    {
      !post.data.hideImage && (
        <img
          src={post.data.image}
          alt={post.data.title}
          class="mx-auto mb-4 rounded-lg object-cover"
        />
      )
    }
    <h1 class="mb-2 text-center text-2xl font-medium">
      {post.data.title}
    </h1>
    <p class="text-center font-medium text-neutral-500 dark:text-neutral-400">
      {formatDate(post.data.date)}
    </p>
    <article>
      <Content />
    </article>

    <!-- Post Navigation -->
    <nav class="flex flex-col gap-4 pt-8 sm:flex-row sm:justify-between">
      <div class="min-w-0 flex-1">
        {
          previousPost && (
            <PostNavButton
              href={`/posts/${previousPost.slug}`}
              direction="previous"
              title={previousPost.data.title}
              date={previousPost.data.date}
            />
          )
        }
      </div>

      <div class="min-w-0 flex-1">
        {
          nextPost && (
            <PostNavButton
              href={`/posts/${nextPost.slug}`}
              direction="next"
              title={nextPost.data.title}
              date={nextPost.data.date}
            />
          )
        }
      </div>
    </nav>
  </main>
</Layout>
