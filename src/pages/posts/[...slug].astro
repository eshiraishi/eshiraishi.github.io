---
import { type CollectionEntry, getCollection } from "astro:content";
import "katex/dist/katex.css";
import Layout from "../../layouts/Layout.astro";
import { formatDate } from "../../lib/utils";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}
type Props = CollectionEntry<"posts">;

const post = Astro.props;
const { Content } = await post.render();

// Get all posts sorted by date (newest first)
const allPosts = await getCollection("posts");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// Find current post index and get previous/next posts
const currentIndex = sortedPosts.findIndex((p) => p.slug === post.slug);
const previousPost =
  currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  lengthClassName="max-w-3xl"
>
  <main>
    {
      !post.data.hideImage && (
        <img
          src={post.data.image}
          alt={post.data.title}
          class="mx-auto mb-4 rounded-lg object-cover"
        />
      )
    }
    <h1 class="mb-2 text-center text-2xl font-medium">
      {post.data.title}
    </h1>
    <p class="text-center font-medium text-neutral-500">
      {formatDate(post.data.date)}
    </p>
    <article>
      <Content />
    </article>

    <!-- Post Navigation -->
    <nav class="flex flex-col gap-4 pt-8 sm:flex-row sm:justify-between">
      <div class="min-w-0 flex-1">
        {
          previousPost && (
            <a
              href={`/posts/${previousPost.slug}`}
              class="group flex flex-col rounded-lg p-2 transition-colors hover:bg-neutral-50 dark:hover:bg-neutral-900"
            >
              <span class="text-sm text-neutral-500 dark:text-neutral-400">
                ← Previous
              </span>
              <span class="mt-1 truncate font-medium group-hover:text-blue-600 dark:group-hover:text-teal-400">
                {previousPost.data.title}
              </span>
              <span class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
                {formatDate(previousPost.data.date)}
              </span>
            </a>
          )
        }
      </div>

      <div class="min-w-0 flex-1">
        {
          nextPost && (
            <a
              href={`/posts/${nextPost.slug}`}
              class="group flex flex-col rounded-lg p-2 text-right transition-colors hover:bg-neutral-50 dark:hover:bg-neutral-900"
            >
              <span class="text-sm text-neutral-500 dark:text-neutral-400">
                Next →
              </span>
              <span class="mt-1 truncate font-medium group-hover:text-blue-600 dark:group-hover:text-teal-400">
                {nextPost.data.title}
              </span>
              <span class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
                {formatDate(nextPost.data.date)}
              </span>
            </a>
          )
        }
      </div>
    </nav>
  </main>
</Layout>
